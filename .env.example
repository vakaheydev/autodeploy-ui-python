# Runtime (server is intentionally localhost-only)
AUTODEPLOY_PORT=8765
AUTODEPLOY_OPENCODE_AUTO_CONNECT=true

# User/corporate secrets. Keep this file outside Git.
LOGIN=
TFS_TOKEN=
ITSM_LOGIN=
ITSM_PASSWORD=
GRAVITEE_TOKEN_TEST_INT=
GRAVITEE_TOKEN_TEST_EXT=
GRAVITEE_TOKEN_REGRESS_INT=
GRAVITEE_TOKEN_REGRESS_EXT=
GRAVITEE_TOKEN_PROD_INT=
GRAVITEE_TOKEN_PROD_EXT=

# OpenCode connection. Provider credentials remain in OpenCode's own config.
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
OPENCODE_CONNECT_TIMEOUT=10
OPENCODE_STARTUP_TIMEOUT=20
OPENCODE_REQUEST_TIMEOUT=120

# Optional private Python packages (module:callable).
AUTODEPLOY_SERVICE_PROVIDER=
AUTODEPLOY_FORM_REGISTRAR=
AUTODEPLOY_REFERENCE_HANDLER_FACTORY=

# Launcher delivery. Normally URL/factory is baked into corporate_update.py.
AUTODEPLOY_UPDATE_MANIFEST_URL=
AUTODEPLOY_UPDATE_PROVIDER=
AUTODEPLOY_UPDATE_TIMEOUT=30
